# Caddy: TLS via Let's Encrypt, and only the Keycloak paths that need to be public.
# Exposed paths follow the Keycloak reverse proxy guide:
# https://www.keycloak.org/server/reverseproxy#_exposed_path_recommendations
{
	email {$ACME_EMAIL}
}

# Re-encrypt: connect to Keycloak over TLS, trusting only the internal certificate
# created by the tls-init service (see internal-tls.sh)
(keycloak) {
	reverse_proxy https://keycloak:8443 {
		transport http {
			tls_trust_pool file /internal-tls/tls.crt
			tls_server_name keycloak
		}
	}
}

# --- Email limits -----------------------------------------------------------------------------
# Keycloak has no limit on the emails it sends. These limits stop people from using the login
# pages to send many emails (which costs money and harms the reputation of our email domain).
#
# Requests that make Keycloak send an email (tested with Keycloak 26.8):
# - the first visit to the "verify your email" page, after registering or when a user with an
#   unverified email address logs in (reloads and the "resend" link are counted too);
# - submitting the "forgot password" form (the page of the password reset where users with a
#   second factor enter it is on the same path, so a reset counts once, or twice with 2FA).
# Logins and token requests are never limited.
#
# Two limits: per IP address (here), and on all email together (in the email relay, which
# counts emails actually sent).

# Public hostname: logins, OIDC endpoints, static resources
{$KC_HOSTNAME} {
	# The limit per IP address uses a sliding window: a request is allowed if fewer than the
	# maximum were allowed in the last period, so spots free up one by one. Refused requests are
	# not counted. It counts requests, not emails, so there is deliberately no limit for all
	# requests together here: anyone could use that up with requests that send nothing.
	rate_limit {
		# Per IP address. Also counts registrations and first logins with Google or GitHub
		# (account creation, and the email to confirm linking an existing account). Generous,
		# because many people can share one address (e.g. a class on a campus network).
		zone email_per_ip {
			match {
				expression `(({method} == "GET" && {path}.matches("^/realms/[^/]+/login-actions/required-action$") && {query.execution} == "VERIFY_EMAIL") || ({method} == "POST" && {path}.matches("^/realms/[^/]+/login-actions/reset-credentials$"))) || ({method} == "POST" && {path}.matches("^/realms/[^/]+/login-actions/(registration|first-broker-login)$"))`
			}
			key {remote_host}
			ipv6_prefix 64
			window {$EMAIL_LIMIT_PER_IP_WINDOW:1h}
			events {$EMAIL_LIMIT_PER_IP:200}
		}
		# Log each refused request with its key (the IP address)
		log_key
	}
	handle_errors 429 {
		vars message "Too many attempts from your network. Please wait a few minutes and try again."
		header Content-Type "text/html; charset=utf-8"
		respond 429 {
			body `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Please try again later</title>
<style>body{margin:0;font:16px/1.5 system-ui,sans-serif;background:#f4f6f9;color:#1d1d1f}main{max-width:480px;margin:15vh auto;padding:32px 24px;background:#fff;border-radius:8px}h1{font-size:1.4rem;margin:0 0 12px}a{color:#0b57d0}@media(prefers-color-scheme:dark){body{background:#17181a;color:#e8eaed}main{background:#222428}a{color:#8ab4f8}}</style>
</head><body><main><h1>Please try again later</h1><p>{vars.message}</p><p><a href="javascript:history.back()">Go back</a></p></main></body></html>`
		}
	}

	@public {
		path /realms/* /resources/* /.well-known/*
		# The admin realm (master) is only reachable via the admin hostname
		not path /realms/master /realms/master/*
	}
	handle @public {
		import keycloak
	}
	# Everything else, including /admin/, is not exposed
	handle {
		respond 404
	}
}

# Admin hostname: the admin consoles and the admin API.
# Restrictions (the university's IP ranges for all realms; optional exceptions per realm) are
# set in admin-access.caddy, a local file that is not in the repository (copied from
# admin-access.example.caddy).
{$KC_HOSTNAME_ADMIN} {
	import admin-access.caddy
	handle {
		import keycloak
	}
}
