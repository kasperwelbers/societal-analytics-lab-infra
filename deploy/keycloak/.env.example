# Copy to .env and fill in the values: cp .env.example .env
# .env contains secrets: never commit it (it is in .gitignore).

# Hostnames, without https:// (all three need a DNS A record pointing to this VM)
KC_HOSTNAME=auth.example.org
KC_HOSTNAME_ADMIN=auth-admin.example.org
# The app registration site (see docs/app-registration.md)
APPS_HOSTNAME=apps.example.org

# Email address for Let's Encrypt (expiry notices)
ACME_EMAIL=admin@example.org

# Limit on requests that make Keycloak send an email, per IP address (sliding window). Generous,
# because many people can share one address (e.g. a class on a campus network): about 100
# sign-ups per hour from one address. Apply with: sudo docker compose up -d caddy
# (The limits per app, only in the idp realm, are in caddy/email-tiers.caddy.)
EMAIL_LIMIT_PER_IP=200
EMAIL_LIMIT_PER_IP_WINDOW=1h

# Database password. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Password of the keystore with the internal TLS certificate (Caddy -> Keycloak).
# Generate with: openssl rand -hex 32
INTERNAL_TLS_KEYSTORE_PASSWORD=

# Temporary admin account, only created on the very first start. The password must meet the
# password policy of master-realm.json (an uppercase letter and a digit).
# Generate with: echo "Temp-$(openssl rand -hex 24)"
# Remove the password from this file once a permanent admin exists.
KC_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Realms (realms/*-realm.json, imported by Keycloak when a realm doesn't exist yet) -----
# The values below are used in the realm files; Keycloak doesn't start while one is missing.

# Email: the relay (mail-relay in docker-compose.yml) sends all email of the realms through
# the email provider. Only the relay gets the password. Use port 587 (STARTTLS, required).
# Scaleway Transactional Email: host smtp.tem.scaleway.com, user = project ID,
# password = an API secret key with only the permission to send email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender address of all emails (the relay accepts no other)
SMTP_FROM=
SMTP_FROM_NAME=Societal Analytics Lab
# Cap on all emails of the whole Keycloak instance. It protects the monthly quota of the email
# provider: keep it well below (an attack that keeps going uses at most 400 x 24 per day).
# Fixed period: above the cap, no email until the period ends. Apply with:
# sudo docker compose up -d mail-relay
EMAIL_RELAY_LIMIT=400
EMAIL_RELAY_LIMIT_PERIOD=1h

# Google and GitHub login for the idp realm (OAuth apps: see the runbook)
IDP_GOOGLE_CLIENT_ID=
IDP_GOOGLE_CLIENT_SECRET=
IDP_GITHUB_CLIENT_ID=
IDP_GITHUB_CLIENT_SECRET=

# --- App registration site --------------------------------------------------------------
# Secret of the client "app-registration" in the idp realm (set by the realm configuration).
# Generate with: openssl rand -hex 32
APP_REGISTRATION_CLIENT_SECRET=
# Signs the session cookies of the site. Generate with: openssl rand -hex 32
APP_REGISTRATION_SESSION_SECRET=
# Apps per user; users can ask for more (see docs/app-registration.md)
MAX_APPS_PER_USER=3
# Shown to users who reach a limit
CONTACT_EMAIL=

# Optional: where to get the Keycloak image (default: the official registry quay.io,
# with the version set in docker-compose.yml). If you set this, keep the version in sync.
# The same official image is also published on Docker Hub:
# KEYCLOAK_IMAGE=docker.io/keycloak/keycloak:26.8.2
