# Caddy: TLS via Let's Encrypt, and only the Keycloak paths that need to be public.
# Exposed paths follow the Keycloak reverse proxy guide:
# https://www.keycloak.org/server/reverseproxy#_exposed_path_recommendations

{
	email {$ACME_EMAIL}
}

# Re-encrypt: connect to Keycloak over TLS, trusting only the internal certificate
# created by the tls-init service (see internal-tls.sh)
(keycloak) {
	reverse_proxy https://keycloak:8443 {
		transport http {
			tls_trust_pool file /internal-tls/tls.crt
			tls_server_name keycloak
		}
	}
}

# Public hostname: logins, OIDC endpoints, static resources
{$KC_HOSTNAME} {
	# Limit the requests that make Keycloak send an email (registration, email verification,
	# forgot password, linking an external account), per client IP address. Many people can
	# share one address (e.g. a campus network), so raise the limit for teaching sessions.
	rate_limit {
		zone keycloak_email {
			match {
				expression `({method} == "POST" && {path}.matches("^/realms/[^/]+/login-actions/(registration|reset-credentials|first-broker-login)$")) || ({path}.matches("^/realms/[^/]+/login-actions/required-action$") && {query.execution} == "VERIFY_EMAIL")`
			}
			key {remote_host}
			ipv6_prefix 64
			window {$EMAIL_RATE_LIMIT_WINDOW:10m}
			events {$EMAIL_RATE_LIMIT_EVENTS:30}
		}
	}
	handle_errors 429 {
		respond "Too many attempts from your network. Please wait a few minutes and try again." 429
	}

	@public {
		path /realms/* /resources/* /.well-known/*
		# The admin realm (master) is only reachable via the admin hostname
		not path /realms/master /realms/master/*
	}
	handle @public {
		import keycloak
	}
	# Everything else, including /admin/, is not exposed
	handle {
		respond 404
	}
}

# Admin hostname: the admin consoles and the admin API.
# Optional restrictions (IP ranges, exceptions per realm) are set in admin-access.caddy,
# a local file that is not in the repository (copied from admin-access.example.caddy).
{$KC_HOSTNAME_ADMIN} {
	import admin-access.caddy
	handle {
		import keycloak
	}
}

# App registration site
{$APPS_HOSTNAME} {
	reverse_proxy app-registration:3000
}
